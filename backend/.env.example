# Copier ce fichier en ".env" pour modifier la configuration (facultatif).
PORT=4000
# 127.0.0.1 = accessible uniquement depuis cet ordinateur (recommandé). 0.0.0.0 = ouvert au réseau local.
HOST=127.0.0.1
# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# À mettre à true seulement si l'application est servie en HTTPS.
# COOKIE_SECURE=true
